{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "file:///home/bio/workflow/config/schema.json",
    "type": "object",
    "required": [
        "datasets",
        "spectral_libraries"
    ],
    "properties": {
        "datasets": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "required": [
                    "mzmine",
                    "analysis"
                ],
                "properties": {
                    "mzmine": {
                        "type": "object",
                        "required": [
                            "template",
                            "retention_time_range",
                            "approximate_feature_fwhm",
                            "minimum_feature_height",
                            "blank_subtraction",
                            "spectral_library_files"
                        ],
                        "properties": {
                            "template": {
                                "type": "string"
                            },
                            "retention_time_range": {
                                "type": "array",
                                "items": {
                                    "type": "number"
                                },
                                "minItems": 2,
                                "maxItems": 2
                            },
                            "approximate_feature_fwhm": {
                                "type": "number"
                            },
                            "minimum_feature_height": {
                                "type": "number"
                            },
                            "blank_subtraction": {
                                "type": "object",
                                "properties": {
                                    "min_blank_presence": {
                                        "type": "integer"
                                    },
                                    "fold_change_threshold": {
                                        "type": "number"
                                    }
                                },
                                "additionalProperties": false
                            },
                            "spectral_library_files": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "minItems": 1
                            }
                        },
                        "additionalProperties": false
                    },
                    "analysis": {
                        "type": "object",
                        "required": [
                            "features",
                            "annotations",
                            "bioactivity"
                        ],
                        "properties": {
                            "features": {
                                "type": "object",
                                "required": [
                                    "pca",
                                    "da_condition_columns"
                                ],
                                "properties": {
                                    "pca": {
                                        "type": "object",
                                        "required": [
                                            "samples_groupby",
                                            "procedural_blanks_groupby"
                                        ],
                                        "properties": {
                                            "samples_groupby": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                }
                                            },
                                            "procedural_blanks_groupby": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                }
                                            }
                                        },
                                        "additionalProperties": false
                                    },
                                    "da_condition_columns": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "additionalProperties": false
                            },
                            "annotations": {
                                "type": "object",
                                "properties": {
                                    "formula_identification_score_cutoff": {
                                        "type": "number"
                                    },
                                    "spectral_library_match_score_cutoff": {
                                        "type": "number"
                                    },
                                    "structure_database_confidence_cutoff": {
                                        "type": "number"
                                    },
                                    "msnovelist_score_cutoff": {
                                        "type": "number"
                                    }
                                },
                                "additionalProperties": false
                            },
                            "bioactivity": {
                                "type": "object",
                                "required": [
                                    "cc_spaces",
                                    "query"
                                ],
                                "properties": {
                                    "cc_spaces": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "query": {
                                        "type": "string"
                                    },
                                    "clusterable_embedding_umap_n_neighbors": {
                                        "type": "integer"
                                    },
                                    "clusterable_embedding_umap_min_dist": {
                                        "type": "number"
                                    },
                                    "clusterable_embedding_umap_n_components": {
                                        "type": "integer"
                                    },
                                    "hdbdscan_min_samples": {
                                        "type": "integer"
                                    },
                                    "hdbscan_min_cluster_size": {
                                        "type": "integer"
                                    }
                                },
                                "additionalProperties": false
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false
            }
        },
        "spectral_libraries": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "required": [
                    "zenodo_id"
                ],
                "properties": {
                    "zenodo_id": {
                        "type": "integer"
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}