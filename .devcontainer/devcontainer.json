{
    "name": "thesis-app",
    "build": {
        "dockerfile": "../Dockerfile"
    },
    "remoteUser": "mambauser",
    "workspaceFolder": "/home/mambauser/workflow",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/mambauser/workflow,type=bind",
    "mounts": [
        "source=${localWorkspaceFolder}/.sirius-6.3,target=/home/mambauser/.sirius-6.3,type=bind",
        "source=${localWorkspaceFolder}/.mzmine,target=/home/mambauser/.mzmine,type=bind"
    ],
    "runArgs": [
        "--user",
        "1000:1000"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff",
                "tfehlmann.snakefmt",
                "redhat.vscode-yaml"
            ]
        }
    }
}