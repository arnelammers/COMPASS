{
    "name": "compass-app",
    "build": {
        "dockerfile": "../Dockerfile"
    },
    "remoteUser": "bio",
    "workspaceFolder": "/home/bio/workflow",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/bio/workflow,type=bind",
    "mounts": [
        "source=${localWorkspaceFolder}/.sirius-6.3,target=/home/bio/.sirius-6.3,type=bind",
        "source=${localWorkspaceFolder}/.mzmine,target=/home/bio/.mzmine,type=bind"
    ],
    "runArgs": [
        "--user",
        "1000:1000",
        "--memory=14g",
        "--shm-size=8g",
        "--dns=1.1.1.1",
        "--dns=8.8.8.8"
    ],
    "containerEnv": {
        "JAVA_TOOL_OPTIONS": "-Xmx10g"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff",
                "tfehlmann.snakefmt",
                "redhat.vscode-yaml",
                "mechatroner.rainbow-csv"
            ]
        }
    }
}